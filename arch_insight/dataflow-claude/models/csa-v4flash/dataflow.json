lue": 6, "desc": "토큰당 고르는 expert 수"}, "E_s": {"value": 1, "desc": "shared expert 수"}, "fp4": {"value": 0.53125, "desc": "FP4 + scale(32값마다 1 B) 바이트/값"}, "V": {"value": 129280, "desc": "어휘 수"}}, "derived": {"E_hit": {"expr": "E*(1-(1-E_k/E)**B)", "desc": "요청 B개가 건드리는 expert 수 기댓값 — 균등 라우팅 가정"}}, "data": [{"id": "w_csa", "label": "가중치 · CSA attention", "short": "CSA attention", "group": "attention 가중치", "block": {"kind": "weight"}, "layers": "L_csa"}, {"id": "w_hca", "label": "가중치 · HCA · 창 attention", "short": "HCA · 창 attention", "group": "attention 가중치", "color": "gray", "share": "공유", "layers": "L_hca", "store": "L_hca*(d*c_q + d*d_h + c_q*n_h*d_h + n_h*d_h*c_o + g_o*c_o*d + 2*2*d*d_h + 4*m_h*d_h) + L_swa*(d*c_q + d*d_h + c_q*n_h*d_h + n_h*d_h*c_o + g_o*c_o*d)", "read": "L_hca*(d*c_q + d*d_h + c_q*n_h*d_h + n_h*d_h*c_o + g_o*c_o*d + 2*2*d*d_h + 4*m_h*d_h) + L_swa*(d*c_q + d*d_h + c_q*n_h*d_h + n_h*d_h*c_o + g_o*c_o*d)", "note": "FP8 · HCA 압축기 wkv · wgate BF16 [512 × 4096] 2장 + 위치 bias. 창 층은 압축기 없음"}, {"id": "w_moe", "label": "가중치 · MoE expert", "short": "MoE expert", "group": "MoE 가중치", "color": "gray-l", "share": "공유", "layers": "n_layer", "store": "n_layer*(E*3*d*d_moe*fp4 + E_s*3*d*d_moe + 2*d*E)", "read": "n_layer*(E_hit*3*d*d_moe*fp4 + E_s*3*d*d_moe + 2*d*E)", "note": "routed FP4 · shared FP8 · router BF16. 읽기 = 요청들이 건드린 expert만 (균등 라우팅 가정)"}, {"id": "w_head", "label": "가중치 · LM head", "short": "LM head", "group": "LM head · 임베딩", "color": "gray-ll", "share": "공유", "layers": 1, "store": "2*V*d", "read": "2*V*d"}, {"id": "w_emb", "label": "가중치 · 임베딩", "short": "임베딩", "group": "LM head · 임베딩", "color": "gray-ll", "share": "공유", "layers": 1, "store": "2*V*d", "read": "2*B*d", "note": "토큰 B개의 행만 읽음"}, {"id": "kv_csa", "label": "KV cache · CSA 압축", "short": "CSA 압축 KV", "group": "KV cache (압축)", "block": {"t": ["kv_cmp"]}, "layers": "L_csa"}, {"id": "kv_hca", "label": "KV cache · HCA 고압축", "short": "HCA 고압축 KV", "group": "KV cache (압축)", "color": "blue", "share": 