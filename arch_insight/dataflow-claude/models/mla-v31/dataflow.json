{"algo": {"model": "DeepSeek-V3.1 (MLA · full attention 기준선)", "scope": "층 1개 · decode 1스텝 · attention 블록 (MoE · FFN 제외)", "dims": {"B": {"value": 1, "short": "요청", "desc": "동시 요청 수", "var": true}, "T": {"value": 131072, "short": "토큰", "desc": "컨텍스트 길이 (새 토큰 포함)", "var": true}, "d": {"value": 7168, "short": "hidden 폭", "desc": "hidden 폭"}, "c_q": {"value": 1536, "short": "q latent 폭", "desc": "q latent 폭 (q_lora_rank)"}, "c_kv": {"value": 512, "short": "KV latent", "desc": "KV latent 폭 (kv_lora_rank)"}, "n_h": {"value": 128, "short": "head", "desc": "attention head 수"}, "d_nope": {"value": 128, "short": "nope 폭", "desc": "head당 RoPE 없는 q·k 폭"}, "d_rope": {"value": 64, "short": "RoPE", "desc": "RoPE 폭 (q · k 공통)"}, "d_v": {"value": 128, "short": "V 폭", "desc": "head당 V 폭"}, "n_layer": {"value": 61, "short": "층 수", "desc": "전체 층 수"}, "T_max": {"value": 163840, "short": "지원 길이", "desc": "max_position_embeddings"}}, "formats": {"kv_row": {"desc": "KV cache 1줄 바이트", "title": "KV cache 1줄 형식", "ui": true, "options": {"fp8": {"value": 656, "label": "FP8 656 B (V3.2와 같은 형식)", "desc": "c_kv 512 FP8 + scale 4개(FP32) + k_rope 64 BF16"}, "bf16": {"value": 1152, "label": "BF16 1,152 B (비교 기준)", "desc": "576값 × BF16"}}, "default": "fp8"}}, "kinds": {"weight": {"label": "가중치", "share": "공유", "color": "gray", "persistent": true, "desc": "모든 요청이 같이 쓴다 — B가 늘어도 그대로"}, "kv": {"label": "KV cache", "share": "요청별", "color": "blue", "persistent": true, "desc": "요청마다 T줄 — 매 스텝 전부 읽음"}, "inter": {"label": "중간 결과", "share": "요청별", "color": "yellow", "desc": "점수 · 부분합처럼 커널 사이에서 잠깐 쓰는 데이터"}, "act": {"label": "토큰 벡터", "share": "요청별", "color": "violet", "desc": "토큰 1개짜리 중간 결과 벡터. 앞 커널이 HBM에 쓰고 다음 커널이 읽음 — 작음"}}, "tensors": {"W_qa": {"label": "W_qa", "shape": ["d", "c_q"], "bytes": "d*c_q", "kind": "weight", "desc": "x → q latent"}, "W_kva": {"label": "W_kva", "shape": ["d", "c_kv+d_rope"], "bytes": "d*(c_kv+d_rope)", "kind": "weight", "desc": "x → KV latent + k_rope"}, "W_qb": {"label": "W_qb", 