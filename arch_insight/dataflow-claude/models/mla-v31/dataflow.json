am"}], "hbm_write": [{"t": "o", "pat": "small"}]}, {"id": "K7", "label": "출력 투영 GEMM", "plain": "head 출력 16,384폭을 hidden 7,168로 투영", "impl": "o_proj GEMM", "steps": ["o2"], "hbm_read": [{"t": "o", "pat": "small"}, {"t": "W_o", "pat": "stream"}], "hbm_write": [{"t": "y", "pat": "small"}]}]}, "checks": null, "pages": "https://kimhyeon-ji.github.io/llm-arch-lineage-wiki/arch_insight/dataflow-claude/viewer/", "nav": [{"file": "mla-v31", "label": "기준선 · DeepSeek-V3.1", "group": ""}, {"file": "dsa-v32", "label": "Sparse · DeepSeek-V3.2", "group": ""}, {"file": "csa-v4flash", "label": "Sparse · DeepSeek-V4-Flash", "group": ""}, {"file": "kda-k3", "label": "Hybrid · Kimi K3.1 Pro (KDA + DSA)", "group": ""}, {"file": "qsa-qwen38", "label": "Hybrid · Qwen3.8-Flash-Next (GDN + QSA)", "group": ""}, {"file": "gdn-qwen36", "label": "Hybrid · Qwen3.6-27B (GDN 층)", "group": ""}], "model": {"model": "DeepSeek-V3.1", "layer_label": "MLA 층 1개", "deploy": {"n_gpu": 8, "desc": "H200 8장 1대 — FP8 가중치 약 680 GB"}, "dims": {"L_dense": {"value": 3, "desc": "dense FFN 층 수"}, "L_moe": {"value": 58, "desc": "MoE 층 수"}, "d_ff": {"value": 18432, "desc": "dense FFN 폭"}, "d_moe": {"value": 2048, "desc": "expert FFN 폭"}, "E": {"value": 256, "desc": "routed expert 수"}, "E_k": {"value": 8, "desc": "토큰당 고르는 expert 수"}, "E_s": {"value": 1, "desc": "shared expert 수"}, "V": {"value": 129280, "desc": "어휘 수"}}, "derived": {"E_hit": {"expr": "E*(1-(1-E_k/E)**B)", "desc": "요청 B개가 건드리는 expert 수 기댓값 — 균등 라우팅 가정"}}, "data": [{"id": "w_attn", "label": "가중치 · attention", "short": "attention", "group": "attention 가중치", "block": {"kind": "weight"}, "layers": "n_layer"}, {"id": "w_ffn", "label": "가중치 · dense FFN", "short": "dense FFN", "group": "MoE · FFN 가중치", "color": "gray-l", "share": "공유", "layers": "L_dense", "store": "L_dense*3*d*d_ff", "read": "L_dense*3*d*d_ff", "note": "FP8"}, {"id": "w_moe", "label": "가중치 · MoE expert", "short": "MoE expert", "group": "MoE · FFN 가중치", "color": "gray-l", "share": "공유", "laye