roup": "MLA 투영", "label": "입력 투영", "unit": "gemm", "prec": "fp8", "in": ["x", "W_qa", "W_kva"], "out": ["q_a", "kv_a"], "flops": "2*B*d*(c_q+c_kv+d_rope)", "desc": "같은 x로 q latent와 KV latent + k_rope를 만든다."}, {"id": "p2", "group": "MLA 투영", "label": "KV 정규화 · RoPE", "unit": "vec", "in": ["kv_a"], "out": ["kv_new"], "elems": "B*(c_kv+d_rope)", "desc": "KV 1줄(576값)을 완성한다."}, {"id": "p3", "group": "MLA 투영", "label": "KV cache 쓰기", "unit": "mem", "viz": "append", "in": ["kv_new"], "out": ["kv_cache"], "elems": "B*(c_kv+d_rope)", "desc": "새 줄 1개를 KV cache 끝에 붙인다."}, {"id": "p4", "group": "MLA 투영", "label": "q 정규화 · 업투영", "unit": "gemm", "prec": "fp8", "in": ["q_a", "W_qb"], "out": ["q"], "flops": "2*B*c_q*n_h*(d_nope+d_rope)", "desc": "q latent를 head 128개 × 192폭으로 펼친다."}, {"id": "p5", "group": "MLA 투영", "label": "q RoPE · W_UK 흡수", "unit": "gemm", "prec": "bf16", "in": ["q", "W_UK"], "out": ["q_full"], "flops": "2*B*n_h*d_nope*c_kv", "desc": "head마다 q_nope를 latent 폭(512)으로 바꾼다."}, {"id": "a1", "group": "MLA attention", "label": "QK 점수", "unit": "gemm", "prec": "bf16", "in": ["q_full", "kv_cache"], "out": ["sc"], "flops": "2*B*n_h*(c_kv+d_rope)*T", "desc": "head 128개 × KV T줄 전부. 모든 head가 같은 KV 줄을 쓴다."}, {"id": "a2", "group": "MLA attention", "label": "softmax", "unit": "vec", "in": ["sc"], "out": ["p"], "elems": "B*n_h*T", "desc": "online softmax."}, {"id": "a3", "group": "MLA attention", "label": "PV", "unit": "gemm", "prec": "bf16", "in": ["p", "kv_cache"], "out": ["o_lat"], "flops": "2*B*n_h*c_kv*T", "desc": "확률로 KV의 c_kv(512) 부분을 가중합한다."}, {"id": "o1", "group": "출력", "label": "W_UV 풀기", "unit": "gemm", "prec": "bf16", "in": ["o_lat", "W_UV"], "out": ["o"], "flops": "2*B*n_h*c_kv*d_v", "desc": "head마다 latent 출력(512)을 V 폭(128)으로."}, {"id": "o2", "group": "출력", "label": "출력 투영", "unit": "gemm", "prec": "fp8", "in": ["o", "W_o"], "out": ["y"], "flops": "2*B*n_h*d_v*d", "desc": "head 출력 16,384폭을 hidden 7,168로."}], "phases": [{"id": "P1", "focus": "p1", "label": "쿼리 · KV 만들